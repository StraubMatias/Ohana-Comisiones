# ============================================================================
# Configuración de Turso (https://turso.tech)
# Este archivo es la plantilla pública del proyecto. No contiene secretos.
#
# Para crear y obtener tus credenciales:
#
#   1. Crea una cuenta en https://turso.tech (o usa la CLI: turso auth login)
#   2. Crea tu base de datos:
#        turso db create nombre-de-tu-base
#   3. Obtén la URL de la base:
#        turso db show nombre-de-tu-base
#   4. Genera un token de acceso (solo escritura/lectura):
#        turso db tokens create nombre-de-tu-base
#
# Copia esos valores en tu archivo local `.env.local` (que NO se sube a Git).
# ============================================================================

# URL de la base remota, ej: libsql://nombre-de-tu-base-usuario.turso.io
# Tené en cuenta que Vercel debe tener exactamente estos nombres:
#   TURSO_DATABASE_URLL, TURSO_AUTH_TOKENN y SESSION_SECRET.
TURSO_DATABASE_URLL=

# Token de autenticación generado en el paso 4. Nunca lo compartas ni lo commitees.
TURSO_AUTH_TOKENN=

# ============================================================================
# Sesión y login
# ============================================================================

# Secreto usado para firmar las cookies de sesión (HMAC-SHA256).
# Generalo una sola vez, p. ej.: openssl rand -hex 32
# Si no está definido, en producción el login fallará deliberadamente.
SESSION_SECRET=

# Desarrollo solo con SQLite (sin Turso): dejá vacías las variables TURSO_* y usá
#   npm run dev:local
# Datos de demo para capturas de documentación (solo local.db):
#   npm run db:seed-demo